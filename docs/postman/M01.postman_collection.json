{
  "info": {
    "_postman_id": "9cc5cde4-e488-4e4d-bd14-5ae35809fd01",
    "name": "PlayRush M01 Foundation",
    "description": "M01 health and standardized unknown-route examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    }
  ],
  "item": [
    {
      "name": "Health - success",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health",
        "description": "Requires the configured MariaDB/MySQL database to be available. Authentication: none."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.status).to.eql('ok');",
              "pm.expect(body.checks.database).to.eql('up');",
              "pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string');",
              "pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
              "pm.expect(pm.response.text()).not.to.include('password');"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown route - negative",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/not-found",
        "description": "Standardized route failure. Authentication: none."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "const body = pm.response.json();",
              "pm.expect(body.error.code).to.eql('ROUTE_NOT_FOUND');",
              "pm.expect(body.error.requestId).to.eql(pm.response.headers.get('X-Request-Id'));",
              "pm.expect(body.error).not.to.have.property('stack');"
            ]
          }
        }
      ]
    }
  ]
}
