{
  "info": {
    "_postman_id": "c63c6c8b-7cc7-4b23-9a3f-1c5fd2930003",
    "name": "PlayRush M03 Identity and Access",
    "description": "Runnable M03 identity examples. Postman manages access/refresh/CSRF cookies in its cookie jar. Set verificationToken from the injected test delivery adapter; no email vendor is configured.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000/api/v1", "type": "string" },
    { "key": "email", "value": "m03-player@example.test", "type": "string" },
    { "key": "username", "value": "m03_player", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "verificationToken", "value": "", "type": "string" },
    { "key": "csrfToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Register player",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/register",
        "description": "Creates a pending player. The response never exposes the verification token or password hash."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created pending account', () => pm.response.to.have.status(201));",
              "pm.test('does not expose secrets', () => { const body = pm.response.text(); pm.expect(body).not.to.include(pm.collectionVariables.get('password')); pm.expect(body).not.to.include('token'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject weak registration",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bad\",\n  \"username\": \"x\",\n  \"password\": \"short\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('validation rejected', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "Verify email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}" },
        "url": "{{baseUrl}}/auth/verify-email",
        "description": "Populate verificationToken from the deterministic test delivery adapter. The token works once."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('verification consumed', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login",
        "description": "Postman stores the three returned cookies automatically. Tokens are absent from JSON."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login accepted', () => pm.response.to.have.status(200));",
              "pm.test('tokens stay out of JSON', () => { const data = pm.response.json().data; pm.expect(data).not.to.have.property('accessToken'); pm.expect(data).not.to.have.property('refreshToken'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"unknown@example.test\",\n  \"password\": \"WrongPassword123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('generic invalid credentials', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('cookie session accepted', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Rotate session",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const csrf = pm.cookies.get('playrush_csrf') || pm.cookies.get('__Host-playrush_csrf');",
              "pm.variables.set('csrfToken', csrf || '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('refresh rotated', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
        "url": "{{baseUrl}}/auth/refresh"
      }
    },
    {
      "name": "Reject refresh without CSRF",
      "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/auth/refresh" },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('CSRF rejected', () => pm.response.to.have.status(403));"] }
        }
      ]
    },
    {
      "name": "Player denied admin probe",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/admin-check" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('player forbidden', () => pm.response.to.have.status(403));"]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const csrf = pm.cookies.get('playrush_csrf') || pm.cookies.get('__Host-playrush_csrf');",
              "pm.variables.set('csrfToken', csrf || '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('logout is idempotent', () => pm.response.to.have.status(204));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
        "url": "{{baseUrl}}/auth/logout"
      }
    }
  ]
}
