{
  "name": "playrush-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PlayRush browser-gaming backend",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && mocha \"dist-test/test/**/*.test.js\"",
    "test:db": "npm run build:test && mocha \"dist-test/test/database/**/*.test.js\"",
    "db:migrate:status": "tsx src/cli/database.ts status",
    "db:migrate:up": "tsx src/cli/database.ts up",
    "db:migrate:down": "tsx src/cli/database.ts down",
    "db:seed": "tsx src/cli/database.ts seed"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mysql2": "3.24.5",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chai": "5.2.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "chai": "6.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "allowScripts": {
    "argon2": true,
    "esbuild": true
  }
}
