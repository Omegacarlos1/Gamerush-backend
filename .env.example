# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# XAMPP MariaDB local development. Create a dedicated database/user; do not use
# root or a blank password outside local setup. Never commit your real .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=playrush_app
DB_PASSWORD=replace-with-a-local-secret
DB_NAME=playrush_dev
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000

# Destructive integration tests use a separate schema. Prefer a dedicated
# least-privilege test account; never point these values at persistent data.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=playrush_test
TEST_DB_PASSWORD=replace-with-a-test-secret
TEST_DB_NAME=playrush_migrations_test
