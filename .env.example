# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Authentication secrets must be independently generated random values of at
# least 32 characters. Secure cookies are mandatory in production; local HTTP
# development may explicitly set AUTH_COOKIE_SECURE=false.
AUTH_ACCESS_TOKEN_SECRET=replace-with-an-independent-random-secret
AUTH_CSRF_SECRET=replace-with-another-independent-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Authenticated game-session issuance is separately throttled. The duplicate
# policy also permits only one open session per player, game, and mode.
GAME_SESSION_RATE_LIMIT_WINDOW_MS=60000
GAME_SESSION_RATE_LIMIT_MAX=10

# XAMPP MariaDB local development. Create a dedicated database/user; do not use
# root or a blank password outside local setup. Never commit your real .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=playrush_app
DB_PASSWORD=replace-with-a-local-secret
DB_NAME=playrush_dev
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000

# Destructive integration tests use a separate schema. Prefer a dedicated
# least-privilege test account; never point these values at persistent data.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=playrush_test
TEST_DB_PASSWORD=replace-with-a-test-secret
TEST_DB_NAME=playrush_migrations_test
